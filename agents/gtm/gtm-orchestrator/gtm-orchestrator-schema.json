{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Coalescent-Emergence/.github/agents/gtm/gtm-orchestrator/gtm-orchestrator-schema.json",
  "title": "GTM Orchestrator Output Schema",
  "type": "object",
  "required": [
    "gtm_frame",
    "delegation_plan",
    "deliverables",
    "confidence",
    "rationale",
    "handoff_next"
  ],
  "properties": {
    "gtm_frame": {
      "type": "object",
      "required": ["target_audience", "primary_channels", "key_messaging"],
      "properties": {
        "target_audience": { "type": "string" },
        "primary_channels": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "key_messaging": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "delegation_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step", "target_agent", "goal"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "target_agent": {
            "type": "string",
            "enum": [
              "social-post-writer",
              "none"
            ]
          },
          "goal": { "type": "string", "minLength": 8 }
        },
        "additionalProperties": false
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
    "rationale": { "type": "string", "minLength": 12 },
    "handoff_next": {
      "$ref": "../../_shared/project-handoff-schema.json#/$defs/HandoffNext"
    }
  },
  "additionalProperties": false
}