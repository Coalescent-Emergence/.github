{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Coalescent-Emergence/.github/agents/infra-architect/infra-architect-schema.json",
  "title": "Infra Architect Output Schema",
  "type": "object",
  "required": ["domain", "agent_to_use", "failing_layer_guess", "likely_causes", "next_commands", "escalation", "lifecycle_handoff", "confidence", "rationale"],
  "properties": {
    "domain": {
      "type": "string",
      "enum": ["Docker", "Talos", "K8s", "Multi-layer"]
    },
    "agent_to_use": {
      "type": "string",
      "enum": ["docker-troubleshooter", "talos-troubleshooter", "k8s-troubleshooter"]
    },
    "failing_layer_guess": { "type": "string", "minLength": 3 },
    "likely_causes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rank", "cause", "evidence_needed"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 5 },
          "cause": { "type": "string", "minLength": 5 },
          "evidence_needed": { "type": "string", "minLength": 5 }
        },
        "additionalProperties": false
      }
    },
    "next_commands": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "escalation": { "$ref": "../../_shared/handoff-schema.json#/$defs/Escalation" },
    "lifecycle_handoff": { "$ref": "../../_shared/handoff-schema.json#/$defs/LifecycleHandoff" },
    "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
    "rationale": { "type": "string", "minLength": 10 }
  },
  "additionalProperties": false
}
