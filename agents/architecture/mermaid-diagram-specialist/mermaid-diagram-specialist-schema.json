{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Coalescent-Emergence/.github/agents/mermaid-diagram-specialist/mermaid-diagram-specialist-schema.json",
  "title": "Mermaid Diagram Specialist Output Schema",
  "type": "object",
  "required": [
    "diagrams",
    "diagram_quality_checks",
    "render_order",
    "confidence",
    "rationale",
    "handoff_next"
  ],
  "properties": {
    "diagrams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "diagram_type", "title", "mermaid_code", "purpose"],
        "properties": {
          "id": { "type": "string", "pattern": "^M[0-9]+$" },
          "diagram_type": {
            "type": "string",
            "enum": ["C4Context", "C4Container", "C4Component", "flowchart", "sequenceDiagram"]
          },
          "title": { "type": "string", "minLength": 5 },
          "purpose": { "type": "string", "minLength": 8 },
          "mermaid_code": { "type": "string", "minLength": 20 },
          "source_sections": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "diagram_quality_checks": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string" }
    },
    "render_order": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^M[0-9]+$" }
    },
    "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
    "rationale": { "type": "string", "minLength": 12 },
    "handoff_next": {
      "$ref": "../../_shared/project-handoff-schema.json#/$defs/HandoffNext"
    }
  },
  "additionalProperties": false
}
