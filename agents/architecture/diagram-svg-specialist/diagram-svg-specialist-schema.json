{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Coalescent-Emergence/.github/agents/diagram-svg-specialist/diagram-svg-specialist-schema.json",
  "title": "Diagram SVG Specialist Output Schema",
  "type": "object",
  "required": [
    "asset_manifest",
    "render_pipeline",
    "qa_checklist",
    "presentation_notes",
    "confidence",
    "rationale",
    "handoff_next"
  ],
  "properties": {
    "asset_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["diagram_id", "svg_filename", "variant", "purpose"],
        "properties": {
          "diagram_id": { "type": "string", "pattern": "^M[0-9]+$" },
          "svg_filename": { "type": "string", "pattern": ".+\\.svg$" },
          "variant": {
            "type": "string",
            "enum": ["default", "slide", "dark", "light"]
          },
          "purpose": { "type": "string", "minLength": 8 }
        },
        "additionalProperties": false
      }
    },
    "render_pipeline": {
      "type": "object",
      "required": ["tooling", "commands", "output_directory"],
      "properties": {
        "tooling": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "commands": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "output_directory": { "type": "string", "minLength": 3 }
      },
      "additionalProperties": false
    },
    "qa_checklist": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string" }
    },
    "presentation_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
    "rationale": { "type": "string", "minLength": 12 },
    "handoff_next": {
      "$ref": "../../_shared/project-handoff-schema.json#/$defs/HandoffNext"
    }
  },
  "additionalProperties": false
}
