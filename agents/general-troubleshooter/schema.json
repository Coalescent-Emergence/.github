{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Coalescent-Emergence/.github/agents/general-troubleshooter/schema.json",
  "title": "General Troubleshooter Input/Output Schema",
  "description": "Schema for root triage and routing decisions.",
  "type": "object",
  "required": ["domain", "routed_to_agent", "triage_summary", "initial_evidence", "next_commands", "handoff_input", "lifecycle_handoff", "confidence", "rationale"],
  "properties": {
    "domain": {
      "type": "string",
      "enum": ["software", "infrastructure", "multi-domain"]
    },
    "routed_to_agent": {
      "type": "string",
      "enum": ["software-architect", "infra-architect"]
    },
    "triage_summary": {
      "type": "string",
      "minLength": 10
    },
    "initial_evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_commands": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "handoff_input": {
      "$ref": "../_shared/handoff-schema.json#/$defs/HandoffInput"
    },
    "lifecycle_handoff": {
      "$ref": "../_shared/handoff-schema.json#/$defs/LifecycleHandoff"
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "rationale": {
      "type": "string",
      "minLength": 10
    }
  },
  "additionalProperties": false
}
